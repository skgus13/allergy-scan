# 서버 환경 설정
APP_ENV=development
DATABASE_URL=sqlite:///./allergy_scan.db

# 공공데이터포털 - HACCP 제품이미지 및 포장지표기정보 API 인증키 (Decoding 키 권장)
HACCP_SERVICE_KEY=your_data_go_kr_service_key_here

# 식품안전나라 Open API 인증키 (선택)
FOOD_SAFETY_API_KEY=your_food_safety_key_here

# Google Cloud Vision API 키 (PaddleOCR 신뢰도 낮을 때 보조 대안, 선택)
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Open Food Facts 커스텀 User-Agent (필수 헤더)
OPENFOODFACTS_USER_AGENT=AllergyScan/1.0 (contact@example.com)

# OCR 신뢰도 임계값 (미만일 경우 UNCERTAIN 판정)
OCR_CONFIDENCE_THRESHOLD=0.65
